{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="app-alert {{ type }}" role="{{ type in ['error', 'danger'] ? 'alert' : 'status' }}" data-controller="alert">
            <span>{{ message }}</span>
            <button type="button" aria-label="Fermer le message" data-action="alert#close">×</button>
        </div>
    {% endfor %}
{% endfor %}

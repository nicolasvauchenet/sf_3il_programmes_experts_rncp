<footer class="app-footer">
    <p class="copyrights">
        © {{ "now"|date("Y") }} 3iL Programmes Experts - Tous Droits Réservés
    </p>

    <div class="footerlinks">
        <a href="{{ path('app_legal_mentions') }}"
           class="{% if 'app_legal_mentions' == app.request.get('_route') %}active{% endif %}">
            Mentions
        </a>
        <a href="{{ path('app_legal_privacy') }}"
           class="{% if 'app_legal_privacy' == app.request.get('_route') %}active{% endif %}">
            Confidentialité
        </a>
        <a href="{{ path('app_legal_gtu') }}"
           class="{% if 'app_legal_gtu' == app.request.get('_route') %}active{% endif %}">
            CGU
        </a>
        {% if app.user %}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_home') }}"
                   class="{% if 'app_admin' in app.request.get('_route') %}active{% endif %}">
                    Admin
                </a>
            {% endif %}
            <a href="{{ path('app_profile') }}"
               class="{% if 'app_profile' == app.request.get('_route') %}active{% endif %}">Profil</a>
            <a href="{{ path('app_logout') }}" onclick="return confirm('Vous partez ?')">Déconnexion</a>
        {% endif %}
    </div>
</footer>

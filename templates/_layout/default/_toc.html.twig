<div
    class="app-toc-wrapper"
    data-controller="toc toc-filter"
    data-toc-selected-code-value="{{ selectedCode|default('')|lower }}"
>
    {# Bouton mobile #}
    <div class="app-toc-mobile-trigger">
        <button
            type="button"
            class="app-toc-mobile-button"
            data-action="click->toc#open"
            data-toc-target="trigger"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="mobile-toc-drawer"
        >
            <span>
                {{ title }}s
                {% if selectedCode %}
                    • {{ selectedCode|upper }}
                {% endif %}
            </span>

            <span class="app-toc-mobile-button-count">
                {{ content|length }}
            </span>
        </button>
    </div>

    {# Aside desktop #}
    <aside class="app-section app-toc app-toc-desktop">
        <h2>{{ title }}s</h2>
        <p class="subtitle">
            {{ content|length }} {{ title|lower }}{{ content|length > 1 ? 's' : '' }}
        </p>

        <div class="app-toc-filter">
            <input
                id="desktop-toc-filter"
                type="search"
                class="app-toc-filter-input"
                placeholder="Filtrer par code ou titre"
                autocomplete="off"
                data-toc-filter-target="input"
                data-action="input->toc-filter#filter search->toc-filter#filter keyup->toc-filter#filter"
            >
        </div>

        <nav
            class="toc"
            aria-label="Navigation des {{ title|lower }}s"
            data-toc-target="desktopNav"
        >
            {% for c in content %}
                {% set tocTitle = c.meta.title ?? c.fileCode|upper %}
                <a
                    href="{{ path(path, {'promotion': promotion, 'year': year, 'code': c.fileCode}) }}"
                    class="{% if selectedCode == c.fileCode %}active{% endif %}"
                    data-search="{{ (c.fileCode ~ ' ' ~ tocTitle)|lower }}"
                    data-toc-filter-target="item"
                >
                    <span class="app-badge">{{ c.fileCode|upper }}</span>
                    {{ tocTitle }}
                </a>
            {% endfor %}
        </nav>

        <p
            class="app-toc-filter-empty"
            data-toc-filter-target="empty"
            hidden
        >
            Aucun résultat.
        </p>
    </aside>

    {# Bottom drawer mobile #}
    <div
        id="mobile-toc-drawer"
        class="app-toc-drawer-backdrop"
        data-toc-target="backdrop"
        data-action="click->toc#backdropClose"
        hidden
    >
        <div
            class="app-toc-drawer"
            data-toc-target="panel"
            role="dialog"
            aria-modal="true"
            aria-labelledby="mobile-toc-title"
        >
            <div class="app-toc-drawer-handle"></div>

            <div class="app-toc-drawer-header">
                <div>
                    <h2 id="mobile-toc-title">{{ title }}s</h2>
                    <p class="subtitle">
                        {{ content|length }} {{ title|lower }}{{ content|length > 1 ? 's' : '' }}
                    </p>
                </div>

                <button
                    type="button"
                    class="app-toc-drawer-close"
                    data-action="click->toc#close"
                    aria-label="Fermer la navigation"
                >
                    Fermer
                </button>
            </div>

            <div class="app-toc-filter">
                <input
                    id="mobile-toc-filter"
                    type="search"
                    class="app-toc-filter-input"
                    placeholder="Filtrer par code ou titre"
                    autocomplete="off"
                    data-toc-filter-target="input"
                    data-action="input->toc-filter#filter search->toc-filter#filter keyup->toc-filter#filter"
                >
            </div>

            <div class="app-toc app-toc-mobile">
                <nav
                    class="toc"
                    aria-label="Navigation mobile des {{ title|lower }}s"
                    data-toc-target="mobileNav"
                >
                    {% for c in content %}
                        {% set tocTitle = c.meta.title ?? c.fileCode|upper %}
                        <a
                            href="{{ path(path, {'promotion': promotion, 'year': year, 'code': c.fileCode}) }}"
                            class="{% if selectedCode == c.fileCode %}active{% endif %}"
                            data-action="click->toc#close"
                            data-search="{{ (c.fileCode ~ ' ' ~ tocTitle)|lower }}"
                            data-toc-filter-target="item"
                        >
                            <span class="app-badge">{{ c.fileCode|upper }}</span>
                            {{ tocTitle }}
                        </a>
                    {% endfor %}
                </nav>
            </div>

            <p
                class="app-toc-filter-empty"
                data-toc-filter-target="empty"
                hidden
            >
                Aucun résultat.
            </p>
        </div>
    </div>
</div>

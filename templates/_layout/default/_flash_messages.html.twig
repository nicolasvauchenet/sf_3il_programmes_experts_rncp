{% set flashes = app.flashes %}

{% if flashes %}
    <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 mt-6 space-y-4" data-controller="flash-messages">
        {% for type, messages in flashes %}
            {% for message in messages %}
                <div
                    class="
                        rounded-lg px-4 py-3 text-sm shadow-sm border
                        {% if type == 'success' %}
                            bg-green-50 text-green-800 border-green-200
                        {% elseif type == 'error' %}
                            bg-red-50 text-red-800 border-red-200
                        {% elseif type == 'warning' %}
                            bg-yellow-50 text-yellow-800 border-yellow-200
                        {% else %}
                            bg-blue-50 text-blue-800 border-blue-200
                        {% endif %}
                    "
                >
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

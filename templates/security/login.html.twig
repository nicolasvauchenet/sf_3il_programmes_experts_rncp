{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main center">
        <section class="app-section boxed">
            <h1>Connexion</h1>
            <p class="subtitle">Acces reserve aux utilisateurs autorises.</p>

            <hr/>

            {% if error %}
                <div class="app-alert error">
                    {% if error.messageKey == "ce compte n'existe pas" %}
                        ce compte n'existe pas
                    {% else %}
                        Identifiants invalides.
                    {% endif %}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="app-form">
                <div class="form-group">
                    <label for="inputEmail" class="form-label">
                        Email
                    </label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="inputEmail"
                        class="form-control"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div class="form-group">
                    <label for="inputPassword" class="form-label">
                        Mot de passe
                    </label>
                    <input
                        type="password"
                        name="_password"
                        id="inputPassword"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-group">
                    <div class="hidden-xs">&nbsp;</div>
                    <button class="app-button form-submit" type="submit">
                        Se connecter
                    </button>
                </div>
            </form>
        </section>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main center">
        <section class="app-section boxed">
            <h1>Mon profil</h1>
            <p class="subtitle">Modifier vos informations de connexion.</p>

            <hr/>

            {{ form_start(form, { attr: { class: 'app-form profile-form', 'data-controller': 'password-visibility' } }) }}
                {{ form_errors(form) }}

                <div class="form-group">
                    {{ form_label(form.fullName) }}
                    <div>
                        {{ form_widget(form.fullName) }}
                        {{ form_errors(form.fullName) }}
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.emailPrefix) }}
                    <div>
                        <div class="email-suffix-field">
                            {{ form_widget(form.emailPrefix) }}
                            <span>@3il.fr</span>
                        </div>
                        {{ form_errors(form.emailPrefix) }}
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.password.first) }}
                    <div>
                        <div class="password-field">
                            {{ form_widget(form.password.first) }}
                            {% include '_components/_password_toggle.html.twig' %}
                        </div>
                        {{ form_errors(form.password) }}
                        {{ form_errors(form.password.first) }}
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.password.second) }}
                    <div>
                        <div class="password-field">
                            {{ form_widget(form.password.second) }}
                            {% include '_components/_password_toggle.html.twig' %}
                        </div>
                        {{ form_errors(form.password.second) }}
                    </div>
                </div>

                <div class="form-group">
                    <a href="{{ path('app_home') }}" class="app-button outline">&laquo; Retour</a>
                    <button type="submit" class="app-button form-submit">Modifier</button>
                </div>
            {{ form_end(form) }}
        </section>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

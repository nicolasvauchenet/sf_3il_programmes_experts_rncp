{% extends 'base.html.twig' %}

{% block title %}EC {{ framework.parcours.intitule }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
        {% include '_layout/default/_header_promotion.html.twig' %}
        {% include '_layout/default/_flash_messages.html.twig' %}

        <main class="flex-1">
            <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
                    <aside class="lg:col-span-4 xl:col-span-3">
                        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm pb-6">
                            <div class="border-b border-slate-200 px-5 py-4">
                                <h3 class="text-sm font-semibold tracking-wide text-slate-700">
                                    Évaluations Certifiantes
                                </h3>
                                <p class="mt-1 text-xs text-slate-500">
                                    {{ framework.epreuves | length }}
                                    évaluation{{ framework.epreuves | length > 1 ? 's' : '' }}
                                </p>
                            </div>

                            <nav class="max-h-[73vh] overflow-y-auto px-2 pt-2 pb-4 border-b border-slate-200">
                                <ul class="space-y-1">
                                    {% for epreuve in framework.epreuves %}
                                        <li>
                                            <a
                                                href="#"
                                                class="group flex items-start gap-3 rounded-xl px-3 py-2 transition hover:bg-slate-100"
                                            >
                                                <span class="mt-0.5 inline-flex shrink-0 rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700 group-hover:bg-white">
                                                    {{ epreuve.code | default('—') }}
                                                </span>
                                                <span class="text-sm font-medium text-slate-800">
                                                    {{ epreuve.intitule | default('Sans intitulé') }}
                                                </span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </nav>
                        </div>
                    </aside>

                    <div class="lg:col-span-8 xl:col-span-9">
                        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10 space-y-8">
                            <header class="space-y-3">
                                <div class="flex items-center justify-between rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 mb-3">
                                    <span>Année académique {{ year }}</span>
                                    <span>{{ framework.parcours.code | upper }}</span>
                                </div>

                                <h2 class="text-2xl font-semibold tracking-tight text-center">
                                    {{ framework.parcours.intitule }}
                                </h2>
                                <h3 class="text-xl font-semibold tracking-tight text-center">
                                    Évaluation{{ framework.epreuves | length > 1 ? 's' : '' }} Certifiante{{ framework.epreuves | length > 1 ? 's' : '' }}
                                </h3>
                            </header>

                            <section class="space-y-3">
                                <h3 class="text-lg font-semibold">Dump</h3>
                                <p class="text-sm text-slate-700 leading-relaxed">
                                    {{ dump(framework.epreuves) }}
                                </p>
                            </section>
                        </article>
                    </div>
                </div>
            </div>
        </main>

        {% include '_layout/default/_footer.html.twig' %}
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    {% if selectedEvaluation is not null %}
        {% set pageTitle = selectedEvaluation.intitule ?? selectedEvaluation.title ?? selectedEvaluation.name ?? 'Évaluation' %}
        {{ pageTitle }} — {{ promotion | upper }} {{ year }}
    {% else %}
        Évaluations {{ promotion | upper }} {{ year }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
        {% include '_layout/default/_header_promotion.html.twig' %}
        {% include '_layout/default/_alert.html.twig' %}

        <main class="flex-1">
            <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
                    <aside class="lg:col-span-4 xl:col-span-3">
                        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm pb-6">
                            <div class="border-b border-slate-200 px-5 py-4">
                                <h3 class="text-sm font-semibold tracking-wide text-slate-700">
                                    Évaluations {{ promotion | upper }}
                                </h3>
                                <p class="mt-1 text-xs text-slate-500">
                                    {{ evaluations | length }}
                                    évaluation{{ evaluations | length > 1 ? 's' : '' }}
                                </p>
                            </div>

                            <nav class="max-h-[73vh] overflow-y-auto px-2 pt-2 pb-4 border-b border-slate-200">
                                <ul class="space-y-1">
                                    {% for evaluation in evaluations %}
                                        {% set code = (evaluation.code ?? evaluation.id ?? '')|lower %}
                                        {% set title = evaluation.intitule ?? evaluation.title ?? evaluation.name ?? 'Sans intitulé' %}
                                        {% set isActive = code and code == selectedCode %}

                                        <li>
                                            <a
                                                href="{{ path('app_promotion_evaluations', {
                                                    promotion: promotion,
                                                    year: year,
                                                    code: code
                                                }) }}"
                                                class="group flex items-start gap-3 rounded-xl px-3 py-2 transition {{ isActive ? 'bg-slate-100 ring-1 ring-slate-200' : 'hover:bg-slate-100' }}"
                                            >
                                                <span class="mt-0.5 inline-flex shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold {{ isActive ? 'bg-white text-slate-900' : 'bg-slate-100 text-slate-700 group-hover:bg-white' }}">
                                                    {{ evaluation.code ?? evaluation.id ?? '—' }}
                                                </span>
                                                <span class="text-sm font-medium {{ isActive ? 'text-slate-900' : 'text-slate-800' }}">
                                                    {{ title }}
                                                </span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </nav>

                            <div class="px-5 pt-4">
                                <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 text-sm text-slate-700 space-y-1">
                                    <div class="flex justify-between">
                                        <span>Modules</span>
                                        <span class="font-medium text-slate-900">{{ summary.modulesTotal }}</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>Compétences</span>
                                        <span class="font-medium text-slate-900">{{ summary.skillsTotal }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="h-3"></div>
                        </div>
                    </aside>

                    <div class="lg:col-span-8 xl:col-span-9">
                        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10 space-y-8">
                            <div class="flex items-center justify-between rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700">
                                <span>Année académique {{ year }}</span>
                                <span>Évaluations Certifiantes {{ promotion | upper }}</span>
                            </div>

                            {% if warnings is not empty %}
                                <section class="space-y-3">
                                    <h3 class="text-lg font-semibold">Warnings</h3>
                                    <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-200">
                                        <ul class="space-y-1 text-sm text-amber-900">
                                            {% for w in warnings %}
                                                <li>
                                                    <span class="font-medium">{{ w.code.value }}</span>
                                                    —
                                                    {{ w.message }}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </section>
                            {% endif %}

                            {% if selectedCode == '' %}
                                <div class="text-center space-y-3">
                                    <h2 class="text-2xl font-semibold tracking-tight">
                                        Aucune évaluation disponible
                                    </h2>
                                    <p class="text-sm text-slate-600">
                                        Ce référentiel ne contient pas encore d’évaluations exploitables.
                                    </p>
                                </div>
                            {% elseif selectedEvaluation is null %}
                                <div class="space-y-4">
                                    <h2 class="text-2xl font-semibold tracking-tight text-amber-800 text-center">
                                        {{ selectedCode | upper }}
                                    </h2>

                                    <div class="rounded-xl bg-amber-50 p-6 ring-1 ring-amber-200">
                                        <p class="text-sm text-amber-900">
                                            Cette évaluation est référencée mais son fichier est manquant ou invalide.
                                        </p>
                                    </div>
                                </div>
                            {% else %}
                                {% set code = selectedEvaluation.code ?? selectedEvaluation.id ?? selectedCode %}
                                {% set title = selectedEvaluation.intitule ?? selectedEvaluation.title ?? selectedEvaluation.name ?? 'Sans intitulé' %}
                                {% set summaryText = selectedEvaluation.summary ?? selectedEvaluation.resume ?? selectedEvaluation.description ?? null %}
                                {% set workload = selectedEvaluation.workload ?? null %}
                                {% set deliverables = selectedEvaluation.deliverables ?? [] %}
                                {% set criteria = selectedEvaluation.criteria ?? selectedEvaluation.indicators ?? [] %}
                                {% set skillsTargeted = selectedEvaluation.skillsTargeted ?? [] %}
                                {% set prerequisites = selectedEvaluation.prerequisites ?? [] %}
                                {% set bibliography = selectedEvaluation.bibliography ?? [] %}

                                <div class="space-y-8">
                                    <header class="space-y-3">
                                        <div class="flex flex-col items-center gap-2">
                                            <div class="inline-flex rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-800">
                                                {{ code }}
                                            </div>
                                            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 text-center">
                                                {{ title }}
                                            </h2>
                                        </div>

                                        {% if summaryText %}
                                            <p class="text-sm text-slate-700 leading-relaxed text-center max-w-3xl mx-auto">
                                                {{ summaryText }}
                                            </p>
                                        {% endif %}

                                        {% if workload is iterable %}
                                            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                                                {% if workload.days is defined %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                                                        <div class="text-xs font-medium text-slate-600">Durée (jours)</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ workload.days }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if workload.hours is defined %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                                                        <div class="text-xs font-medium text-slate-600">Durée (heures)</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ workload.hours }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if deliverables is iterable %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                                                        <div class="text-xs font-medium text-slate-600">Livrables</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ deliverables | length }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if criteria is iterable %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                                                        <div class="text-xs font-medium text-slate-600">Critères</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ criteria | length }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </header>

                                    {% if skillsTargeted is iterable and skillsTargeted|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Compétences mobilisées</h3>
                                            <div class="flex flex-wrap gap-2">
                                                {% for s in skillsTargeted %}
                                                    <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-800 ring-1 ring-slate-200">
                                                        {{ s }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if prerequisites is iterable and prerequisites|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Prérequis</h3>
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <ul class="list-disc pl-5 space-y-2 text-sm text-slate-700">
                                                    {% for p in prerequisites %}
                                                        <li>{{ p }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if deliverables is iterable and deliverables|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Livrables attendus</h3>
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <ul class="list-disc pl-5 space-y-2 text-sm text-slate-700">
                                                    {% for d in deliverables %}
                                                        <li>{{ d }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if criteria is iterable and criteria|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Critères d’évaluation</h3>
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <ul class="list-disc pl-5 space-y-2 text-sm text-slate-700">
                                                    {% for c in criteria %}
                                                        <li>{{ c }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if bibliography is iterable and bibliography|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Ressources</h3>
                                            <div class="space-y-3">
                                                {% for b in bibliography %}
                                                    {% if b is iterable %}
                                                        {% set bTitle = b.title ?? 'Ressource' %}
                                                        {% set bAuthor = b.author ?? '' %}
                                                        {% set bPublisher = b.publisher ?? '' %}
                                                        <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                            <div class="text-sm font-semibold text-slate-900">
                                                                {{ bTitle }}
                                                            </div>
                                                            {% if bAuthor or bPublisher %}
                                                                <div class="mt-1 text-xs text-slate-600">
                                                                    {{ bAuthor }}{% if bAuthor and bPublisher %} — {% endif %}{{ bPublisher }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    {% else %}
                                                        <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                            <div class="text-sm text-slate-800">
                                                                {{ b }}
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        </section>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </article>
                    </div>
                </div>
            </div>
        </main>

        {% include '_layout/default/_footer.html.twig' %}
    </div>
{% endblock %}

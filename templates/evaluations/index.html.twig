{% extends 'base.html.twig' %}

{% block title %}
    {{ promotionContext.promotionLabel ?? 'Résumé du Référentiel' }}
    - Évaluation {{ evaluation.evaluationCode }} -
    {{ evaluation.title ?: '' }}
{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid third layout">
            {% include '_layout/default/_toc.html.twig' with {
                'title': 'Évaluation',
                'path': 'app_promotion_evaluations',
                'promotion': promotion,
                'year': year,
                'content': evaluations,
                'selectedCode': selectedCode
            } %}

            <article>
                <div class="app-grid third">
                    <section class="app-section centered">
                        <h3 class="text-center alt">{{ promotionContext.promotionTitle }}</h3>

                        <div class="info">
                            <h4 class="text-center">Fiche Évaluation {{ evaluation.evaluationCode }}</h4>
                            <h1>{{ evaluation.title ?: 'Évaluation' }}</h1>
                        </div>

                        <div class="ribbon">
                            <span class="app-badge">{{ promotion | upper }}</span>

                            {% if evaluation.evaluationCode %}
                                <span class="app-badge">{{ evaluation.evaluationCode }}</span>
                            {% endif %}

                            <span class="app-badge">{{ year }}</span>

                            {% if evaluation.totalDuration %}
                                <span class="app-badge">{{ evaluation.totalDuration }}</span>
                            {% endif %}
                        </div>
                    </section>

                    <section class="app-section centered">
                        <h2>Métriques</h2>

                        <div style="height: 200px;">
                            {{ render_chart(evaluationVolumeChart) }}
                        </div>
                    </section>
                </div>

                {% if evaluation.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>{{ evaluation.blocCode }} : {{ evaluation.blocName }}</h2>

                        <p>{{ evaluation.description }}</p>
                    </section>
                {% endif %}

                {% if evaluation.format or evaluation.delivery or evaluation.totalDuration %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Modalités</h2>

                        <p>
                            <strong>Format :</strong>
                            {{ evaluation.format ?: '-' }}
                        </p>
                        <p>
                            <strong>Déroulé :</strong>
                            {{ evaluation.delivery ?: '-' }}
                        </p>
                    </section>
                {% endif %}

                {% set examParts = evaluation.examParts %}
                {% if examParts is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Épreuves</h2>

                        {% if examParts | length > 1 %}
                        <div class="app-grid two">
                            {% endif %}

                            {% for part in examParts %}
                                <section class="app-section mx-0 my-0">
                                    <h3 class="mb-0">{{ evaluation.evaluationCode }}{{ examParts | length > 1 ? '.' ~ loop.index : '' }}</h3>

                                    <p class="subtitle text-left">{{ part.title }}</p>

                                    <p>
                                        <strong>Type :</strong>
                                        {{ part.type ?? '-' }}
                                    </p>
                                    <p>
                                        <strong>Coefficient :</strong>
                                        {{ part.coefficient ?? '-' }}
                                    </p>
                                    <p>
                                        <strong>Points :</strong>
                                        {{ part.points ?? '-' }}
                                    </p>
                                    <p>
                                        <strong>Durée :</strong>
                                        {{ part.duration ?? '-' }}
                                    </p>
                                </section>
                            {% endfor %}

                            {% if examParts | length > 1 %}
                        </div>
                        {% endif %}
                    </section>
                {% endif %}

                {% if evaluation.examThreshold or evaluation.compensationMin or evaluation.remedialBelow or evaluation.blockThreshold %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Règles de validation</h2>

                        <div class="app-grid two">
                            <div class="app-section mx-0 my-0">
                                <strong>Validation de l’évaluation :</strong>
                                {{ evaluation.examThreshold ?: '-' }}
                            </div>
                            <div class="app-section mx-0 my-0">
                                <strong>Compensation possible à partir de :</strong>
                                {{ evaluation.compensationMin ?: '-' }}
                            </div>
                            <div class="app-section mx-0 my-0">
                                <strong>Rattrapage obligatoire en dessous de :</strong>
                                {{ evaluation.remedialBelow ?: '-' }}
                            </div>
                            <div class="app-section mx-0 my-0">
                                <strong>Validation du bloc :</strong>
                                {{ evaluation.blockThreshold ?: '-' }}
                            </div>
                        </div>
                    </section>
                {% endif %}

                {% if evaluation.skillsWithCriteria is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in evaluation.skillsWithCriteria %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {
                                        'promotion': promotion,
                                        'year': year,
                                        'code': s.fileCode
                                    }) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>

                            {% if s.criteria is not empty %}
                                <section class="app-section sub">
                                    <p class="mb-1">
                                        <strong>Critères d’évaluation</strong>
                                    </p>

                                    <ul>
                                        {% for criterion in s.criteria %}
                                            <li>{{ criterion }}</li>
                                        {% endfor %}
                                    </ul>
                                </section>
                            {% endif %}
                        {% endfor %}
                    </section>
                {% elseif evaluation.skills is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in evaluation.skills %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {
                                        'promotion': promotion,
                                        'year': year,
                                        'code': s.fileCode
                                    }) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                <div class="app-grid two">
                    {% if evaluation.modules is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Matières associées</h2>

                            <div class="app-grid">
                                {% for module in evaluation.modules %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_modules', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': module.code
                                            }) }}">
                                                <strong>{{ module.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ module.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if evaluation.projects is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Projets associés</h2>

                            <div class="app-grid">
                                {% for project in evaluation.projects %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_projects', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': project.code
                                            }) }}">
                                                <strong>{{ project.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ project.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}
                </div>
            </article>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

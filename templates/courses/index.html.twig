{% extends 'base.html.twig' %}

{% block title %}
    {% if selectedModule is not null %}
        {% set pageTitle = selectedModule.intitule ?? selectedModule.title ?? selectedModule.name ?? 'Matière' %}
        {{ pageTitle }} — {{ promotion | upper }} {{ year }}
    {% else %}
        Matières {{ promotion | upper }} {{ year }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
        {% include '_layout/default/_header_promotion.html.twig' %}
        {% include '_layout/default/_flash_messages.html.twig' %}

        <main class="flex-1">
            <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 sm:py-10">
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
                    <aside class="lg:col-span-4 xl:col-span-3">
                        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm pb-6">
                            <div class="border-b border-slate-200 px-5 py-4">
                                <h3 class="text-sm font-semibold tracking-wide text-slate-700">
                                    Matières {{ promotion | upper }}
                                </h3>
                                <p class="mt-1 text-xs text-slate-500">
                                    {{ modules | length }}
                                    matière{{ modules | length > 1 ? 's' : '' }}
                                </p>
                            </div>

                            <nav class="max-h-[73vh] overflow-y-auto px-2 pt-2 pb-4 border-b border-slate-200">
                                <ul class="space-y-1">
                                    {% for module in modules %}
                                        {% set code = (module.code ?? module.id ?? '')|lower %}
                                        {% set title = module.intitule ?? module.title ?? module.name ?? 'Sans intitulé' %}
                                        {% set isActive = code and code == selectedCode %}

                                        <li>
                                            <a
                                                href="{{ path('app_promotion_courses', {
                                                    promotion: promotion,
                                                    year: year,
                                                    code: code
                                                }) }}"
                                                class="group flex items-start gap-3 rounded-xl px-3 py-2 transition {{ isActive ? 'bg-slate-100 ring-1 ring-slate-200' : 'hover:bg-slate-100' }}"
                                            >
                                                <span class="mt-0.5 inline-flex shrink-0 rounded-md px-2 py-0.5 text-xs font-semibold {{ isActive ? 'bg-white text-slate-900' : 'bg-slate-100 text-slate-700 group-hover:bg-white' }}">
                                                    {{ module.code ?? module.id ?? '—' }}
                                                </span>
                                                <span class="text-sm font-medium {{ isActive ? 'text-slate-900' : 'text-slate-800' }}">
                                                    {{ title }}
                                                </span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </nav>

                            <div class="px-5 pt-4">
                                <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 text-sm text-slate-700 space-y-1">
                                    <div class="flex justify-between">
                                        <span>Modules</span>
                                        <span class="font-medium text-slate-900">{{ summary.modulesTotal }}</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>Compétences</span>
                                        <span class="font-medium text-slate-900">{{ summary.skillsTotal }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="h-3"></div>
                        </div>
                    </aside>

                    <div class="lg:col-span-8 xl:col-span-9">
                        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10 space-y-8">
                            <div class="flex items-center justify-between rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700">
                                <span>Année académique {{ year }}</span>
                                <span>Matières {{ promotion | upper }}</span>
                            </div>

                            {% if warnings is not empty %}
                                <section class="space-y-3">
                                    <h3 class="text-lg font-semibold">Warnings</h3>
                                    <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-200">
                                        <ul class="space-y-1 text-sm text-amber-900">
                                            {% for w in warnings %}
                                                <li>
                                                    <span class="font-medium">{{ w.code.value }}</span>
                                                    —
                                                    {{ w.message }}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </section>
                            {% endif %}

                            {% if selectedCode == '' %}
                                <div class="text-center space-y-3">
                                    <h2 class="text-2xl font-semibold tracking-tight">
                                        Aucune matière disponible
                                    </h2>
                                    <p class="text-sm text-slate-600">
                                        Ce référentiel ne contient pas encore de modules exploitables.
                                    </p>
                                </div>
                            {% elseif selectedModule is null %}
                                <div class="space-y-4">
                                    <h2 class="text-2xl font-semibold tracking-tight text-amber-800 text-center">
                                        {{ selectedCode | upper }}
                                    </h2>

                                    <div class="rounded-xl bg-amber-50 p-6 ring-1 ring-amber-200">
                                        <p class="text-sm text-amber-900">
                                            Cette matière est référencée mais son fichier est manquant ou invalide.
                                        </p>
                                    </div>
                                </div>
                            {% else %}
                                {% set code = selectedModule.code ?? selectedModule.id ?? selectedCode %}
                                {% set title = selectedModule.intitule ?? selectedModule.title ?? selectedModule.name ?? 'Sans intitulé' %}
                                {% set summaryText = selectedModule.summary ?? selectedModule.resume ?? selectedModule.description ?? null %}
                                {% set workload = selectedModule.workload ?? null %}
                                {% set prerequisites = selectedModule.prerequisites ?? [] %}
                                {% set objectives = selectedModule.objectives ?? [] %}
                                {% set skillsTargeted = selectedModule.skillsTargeted ?? [] %}
                                {% set outline = selectedModule.outline ?? [] %}
                                {% set exercises = selectedModule.exercises ?? [] %}
                                {% set teachingMethods = selectedModule.teachingMethods ?? [] %}
                                {% set bibliography = selectedModule.bibliography ?? [] %}

                                <div class="space-y-8">
                                    <header class="space-y-3">
                                        <div class="flex flex-col items-center gap-2">
                                            <div class="inline-flex rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-800">
                                                {{ code }}
                                            </div>
                                            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 text-center">
                                                {{ title }}
                                            </h2>
                                        </div>

                                        {% if summaryText %}
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <p class="text-sm text-slate-700 leading-relaxed max-w-3xl mx-auto">
                                                    {{ summaryText }}
                                                </p>
                                            </div>
                                        {% endif %}

                                        {% if workload is iterable %}
                                            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                                                {% if workload.days is defined %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 text-center">
                                                        <div class="text-xs font-medium text-slate-600">Charge (jours)</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ workload.days }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if workload.hours is defined %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 text-center">
                                                        <div class="text-xs font-medium text-slate-600">Charge (heures)</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ workload.hours }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if prerequisites is iterable %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 text-center">
                                                        <div class="text-xs font-medium text-slate-600">Prérequis</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ prerequisites | length }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if exercises is iterable %}
                                                    <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 text-center">
                                                        <div class="text-xs font-medium text-slate-600">Exercices</div>
                                                        <div class="mt-1 text-lg font-semibold text-slate-900">
                                                            {{ exercises | length }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </header>

                                    {% if prerequisites is iterable and prerequisites|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Prérequis</h3>
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <ul class="list-disc pl-5 space-y-2 text-sm text-slate-700">
                                                    {% for p in prerequisites %}
                                                        <li>{{ p }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if objectives is iterable and objectives|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Objectifs pédagogiques</h3>
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <ul class="list-disc pl-5 space-y-2 text-sm text-slate-700">
                                                    {% for o in objectives %}
                                                        <li>{{ o }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if skillsTargeted is iterable and skillsTargeted|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Compétences ciblées</h3>
                                            <div class="flex flex-wrap gap-2">
                                                {% for s in skillsTargeted %}
                                                    <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-800 ring-1 ring-slate-200">
                                                        {{ s }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if outline is iterable and outline|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Plan du cours</h3>
                                            <div class="space-y-3">
                                                {% for part in outline %}
                                                    {% set partTitle = part.title ?? 'Sans titre' %}
                                                    {% set items = part.items ?? [] %}

                                                    <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                        <div class="flex items-center justify-between gap-4">
                                                            <h4 class="text-sm font-semibold text-slate-900">
                                                                {{ loop.index }}. {{ partTitle }}
                                                            </h4>
                                                            {% if items is iterable %}
                                                                <span class="text-xs font-medium text-slate-600">
                                                                    {{ items|length }} point{{ items|length > 1 ? 's' : '' }}
                                                                </span>
                                                            {% endif %}
                                                        </div>

                                                        {% if items is iterable and items|length > 0 %}
                                                            <ul class="mt-3 list-disc pl-5 space-y-2 text-sm text-slate-700">
                                                                {% for item in items %}
                                                                    <li>{{ item }}</li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if exercises is iterable and exercises|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Exercices</h3>
                                            <div class="space-y-3">
                                                {% for ex in exercises %}
                                                    {% set exTitle = ex.title ?? 'Exercice' %}
                                                    {% set exDesc = ex.description ?? null %}
                                                    {% set exDeliverables = ex.deliverables ?? [] %}

                                                    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
                                                        <h4 class="text-sm font-semibold text-slate-900">
                                                            {{ loop.index }}. {{ exTitle }}
                                                        </h4>

                                                        {% if exDesc %}
                                                            <p class="mt-3 whitespace-pre-line text-sm text-slate-700 leading-relaxed">
                                                                {{ exDesc }}
                                                            </p>
                                                        {% endif %}

                                                        {% if exDeliverables is iterable and exDeliverables|length > 0 %}
                                                            <div class="mt-4 rounded-lg bg-slate-50 p-4 ring-1 ring-slate-200">
                                                                <div class="text-xs font-semibold text-slate-700">
                                                                    Livrables
                                                                </div>
                                                                <ul class="mt-2 list-disc pl-5 space-y-1 text-sm text-slate-700">
                                                                    {% for d in exDeliverables %}
                                                                        <li>{{ d }}</li>
                                                                    {% endfor %}
                                                                </ul>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if teachingMethods is iterable and teachingMethods|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Méthodes pédagogiques</h3>
                                            <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                <div class="flex flex-wrap gap-2">
                                                    {% for m in teachingMethods %}
                                                        <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-medium text-slate-800 ring-1 ring-slate-200">
                                                            {{ m }}
                                                        </span>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </section>
                                    {% endif %}

                                    {% if bibliography is iterable and bibliography|length > 0 %}
                                        <section class="space-y-3">
                                            <h3 class="text-lg font-semibold text-slate-900">Bibliographie</h3>
                                            <div class="space-y-3">
                                                {% for b in bibliography %}
                                                    {% set bTitle = b.title ?? 'Ressource' %}
                                                    {% set bAuthor = b.author ?? '' %}
                                                    {% set bPublisher = b.publisher ?? '' %}

                                                    <div class="rounded-xl bg-slate-50 p-5 ring-1 ring-slate-200">
                                                        <div class="text-sm font-semibold text-slate-900">
                                                            {{ bTitle }}
                                                        </div>
                                                        {% if bAuthor or bPublisher %}
                                                            <div class="mt-1 text-xs text-slate-600">
                                                                {{ bAuthor }}{% if bAuthor and bPublisher %} — {% endif %}{{ bPublisher }}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </section>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </article>
                    </div>
                </div>
            </div>
        </main>

        {% include '_layout/default/_footer.html.twig' %}
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block body %}
    {% include '_layout/admin/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main center">
        <section class="app-section boxed">
            <h1>Modifier un utilisateur</h1>
            <p class="subtitle">{{ user.fullName }}</p>

            <hr/>

            {{ form_start(form, { attr: { class: 'app-form admin-user-form', 'data-controller': 'password-visibility' } }) }}
            {{ form_errors(form) }}

            <div class="form-group">
                {{ form_label(form.fullName) }}
                <div>
                    {{ form_widget(form.fullName) }}
                    {{ form_errors(form.fullName) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.emailPrefix) }}
                <div>
                    <div class="email-suffix-field">
                        {{ form_widget(form.emailPrefix) }}
                        <span>@3il.fr</span>
                    </div>
                    {{ form_errors(form.emailPrefix) }}
                </div>
            </div>

            {% if canDelete or user.id == app.user.id %}
                <div class="form-group">
                    {{ form_label(form.password) }}
                    <div>
                        <div class="password-field">
                            {{ form_widget(form.password) }}
                            {% include '_components/_password_toggle.html.twig' %}
                        </div>
                        {{ form_errors(form.password) }}
                    </div>
                </div>
            {% endif %}

            {% if canDelete %}
                <div class="form-group">
                    {{ form_label(form.role) }}
                    <div>
                        {{ form_widget(form.role) }}
                        {{ form_errors(form.role) }}
                    </div>
                </div>
            {% else %}
                <input type="hidden" name="edit_user[role]" value="ROLE_ADMIN"/>
            {% endif %}

            {{ form_widget(form._token) }}

            <div class="form-group">
                <a href="{{ path('app_admin_users_home') }}" class="app-button outline">&laquo; Retour</a>
                <button type="submit" class="app-button form-submit">Modifier</button>
            </div>
            {{ form_end(form, {render_rest: false}) }}
        </section>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

<!DOCTYPE html>
<html lang="{{ app.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{% block title %}{% endblock %} - 3iL Ingénieurs</title>

        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        <link rel="icon" href="{{ asset('favicon-96x96.png') }}" type="image/png" sizes="96x96">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}" sizes="180x180">
        <meta name="apple-mobile-web-app-title" content="3iL">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">

        <meta name="theme-color" content="#005067">

        {% block stylesheets %}{% endblock %}

        {% if pdfMode|default(false) %}
            <style>
                @page {
                    margin-top: 28mm;
                    margin-right: 12mm;
                    margin-bottom: 15mm;
                    margin-left: 12mm;
                }
                * { box-sizing: border-box; }
                html { padding: 0; color: #24333b; background: #fff; font-family: "Montserrat", sans-serif; font-size: 9pt; line-height: 1.35; }
                body { margin: 0; padding: 0; color: #24333b; background-color: #fff !important; font-family: "Montserrat", sans-serif; font-size: 9pt; line-height: 1.35; }
                .app-main { margin: 0; }
                article { width: auto; margin: 0; }
                .app-grid { display: block; }
                .app-section { margin: 0 0 4mm; padding: 3.5mm 4mm; background: #fff; border: 0; border-radius: 0; }
                .app-section .app-section { page-break-inside: avoid; }
                .app-section.sub { margin-left: 4mm !important; }
                .centered, .text-center { text-align: center; }
                h1, h2, h3, h4 { page-break-after: avoid; color: #005067; }
                h1 { margin: 2mm 0; font-size: 20pt; font-family: "Bebas Neue"; font-weight: normal; text-transform: uppercase; }
                h2 { font-family: "Bebas Neue"; font-weight: normal; letter-spacing: 0.5pt; margin: 0 0 3mm; padding: 2.5mm 3mm; color: #fff; background: #005067; border-left: 1.5mm solid #e84d0d; font-size: 14pt; text-align: left; text-transform: uppercase; }
                h3 { margin: 0 0 2mm; font-size: 10pt; }
                h4 { margin: 0 0 2mm; font-size: 9pt; }
                p { margin: 0 0 2mm; }
                ul, ol { margin: 1.5mm 0 1.5mm 5mm; padding-left: 3mm; }
                li { margin-bottom: 0.8mm; }
                a { color: inherit; text-decoration: none; }
                .ribbon { margin: 3mm 0 0; text-align: center; }
                .app-badge { display: inline-block; margin: 0 1mm; padding: 1mm 2mm; color: #005067; background: #e5eef1; border-radius: 1mm; font-weight: bold; }
                .pdf-metrics { width: 100%; border-collapse: separate; border-spacing: 2mm 0; text-align: center; }
                .pdf-metrics td { width: 33.33%; padding: 2.5mm; background: #eef3f5; border-bottom: 1mm solid #005067; }
                .pdf-metrics strong { display: block; font-size: 15pt; color: #005067; }
                .pdf-metrics span { font-size: 8pt; text-transform: uppercase; }
                .pdf-cover { margin: -28mm -12mm -15mm; padding: 36mm 20mm 18mm; color: #005067; background: #fff; page-break-after: always; }
                .pdf-cover-kicker { margin-bottom: 5mm; color: #e84d0d; font-size: 11pt; font-weight: bold; letter-spacing: 1.8pt; text-transform: uppercase; }
                .pdf-cover-program { width: 82%; color: #466a77; font-size: 11pt; line-height: 1.45; }
                .pdf-cover-code { margin-top: 10mm; color: #005067; font-size: 12pt; font-weight: bold; letter-spacing: 0.5pt; }
                .pdf-cover h1 { width: 90%; margin: 3mm 0 6mm; color: #005067; font-size: 29pt; line-height: 1.15; }
                .pdf-cover-rule { width: 24mm; height: 1.5mm; margin-bottom: 9mm; background: #e84d0d; }
                .pdf-cover-details, .pdf-cover-stats { width: 100%; border-collapse: separate; border-spacing: 3mm; table-layout: fixed; }
                .pdf-cover-details { margin: 0 -3mm 8mm; }
                .pdf-cover-details td { width: 33.33%; padding: 4mm; vertical-align: top; background: #f7f9fa; border-top: 0.8mm solid #086694; }
                .pdf-cover-details span, .pdf-cover-details small { display: block; color: #68828b; font-size: 7.5pt; line-height: 1.35; }
                .pdf-cover-details span { margin-bottom: 2mm; text-transform: uppercase; }
                .pdf-cover-details strong { display: block; margin-bottom: 1mm; color: #005067; font-size: 13pt; }
                .pdf-cover-stats { margin: 0 -3mm; }
                .pdf-cover-stats td { padding: 4mm 2mm; text-align: center; background: #005067; }
                .pdf-cover-stats strong { display: block; color: #fff; font-size: 20pt; }
                .pdf-cover-stats span { color: #dbe8ec; font-size: 6.8pt; text-transform: uppercase; }
                .pdf-cover-footer { margin-top: 12mm; padding-top: 4mm; color: #68828b; border-top: 0.3mm solid #b7cbd2; font-size: 8pt; letter-spacing: 0.4pt; }
                .pdf-cover--compact { padding-top: 28mm; }
                .pdf-cover--compact .pdf-cover-kicker { margin-bottom: 4mm; }
                .pdf-cover--compact .pdf-cover-code { margin-top: 7mm; }
                .pdf-cover--compact h1 { margin-bottom: 4mm; font-size: 22pt; line-height: 1.12; }
                .pdf-cover--compact .pdf-cover-rule { margin-bottom: 6mm; }
                .pdf-cover--compact .pdf-cover-details { margin-bottom: 5mm; }
                .pdf-cover--compact .pdf-cover-details td { padding: 3mm; }
                .pdf-cover--compact .pdf-cover-stats td { padding: 3mm 2mm; }
                .pdf-cover--compact .pdf-cover-footer { margin-top: 6mm; }
                .pdf-associations { display: table; width: 100%; border-collapse: separate; border-spacing: 2mm 0; table-layout: fixed; }
                .pdf-associations > .app-section { display: table-cell; width: 50%; vertical-align: top; }
                .pdf-chapter { margin-bottom: 3mm !important; padding: 4mm !important; background: #f7f9fa; border-left: 1mm solid #086694 !important; }
                .pdf-chapter h3 { color: #005067; }
                .pdf-exercise { margin-bottom: 4mm !important; padding: 4mm 4.5mm !important; background: #fbfcfc; border: 0.3mm solid #d8e4e8 !important; border-left: 1mm solid #e84d0d !important; }
                .pdf-exercise h3 { color: #005067; }
                .pdf-skill { padding: 3.5mm 4mm !important; background: #f7f9fa; border-left: 1mm solid #086694 !important; }
                .pdf-keep { page-break-inside: avoid; }
                .pdf-section-parent { padding-right: 0; padding-left: 0; }
                .pdf-section-parent > h2 { margin-right: 0; margin-left: 0; }
                .info { margin-top: 2mm; }
                .subtitle { color: #555; font-style: italic; }
                .mt-2 { margin-top: 4mm !important; }
                .mb-0, .my-0 { margin-bottom: 0 !important; }
                .mx-0 { margin-right: 0 !important; margin-left: 0 !important; }
                canvas, .print-button { display: none !important; }
            </style>
        {% endif %}

        {% if not pdfMode|default(false) %}
            {% block javascripts %}
                {% block importmap %}{{ importmap('app') }}{% endblock %}
            {% endblock %}
        {% endif %}
    </head>
    <body>
        {% if not pdfMode|default(false) %}
            <a class="skip-link" href="#main-content">Aller au contenu</a>
            {% include '_components/_confirm_dialog.html.twig' %}
        {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>

<!DOCTYPE html>
<html lang="{{ app.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{% block title %}{% endblock %} - 3iL Programmes Experts</title>

        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        <link rel="icon" href="{{ asset('favicon-96x96.png') }}" type="image/png" sizes="96x96">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}" sizes="180x180">
        <meta name="apple-mobile-web-app-title" content="3iL PE">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">

        {% if not pdfMode|default(false) %}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        {% endif %}

        {% block stylesheets %}{% endblock %}

        {% if pdfMode|default(false) %}
            <style>
                @page {
                    margin-top: 31mm;
                    margin-right: 8mm;
                    margin-bottom: 12mm;
                    margin-left: 8mm;
                }
                * { box-sizing: border-box; }
                html { padding: 0; color: #202020; background: #fff; font-family: "DejaVu Sans", sans-serif; font-size: 9pt; line-height: 1.35; }
                body { margin: 0; padding: 0; color: #202020; background-color: #fff !important; font-family: "DejaVu Sans", sans-serif; font-size: 9pt; line-height: 1.35; }
                .app-main { margin: 0 5mm; }
                article { width: auto; margin: 0; }
                .app-grid { display: block; }
                .app-section { margin: 0 0 4mm; padding: 4mm; background: #fff; border: 0.25mm solid #b8b8b8; border-radius: 1.5mm; }
                .app-section.pdf-section-parent { border: 0; border-radius: 0; }
                .app-section .app-section { page-break-inside: avoid; }
                .app-section.sub { margin-left: 4mm !important; }
                .centered, .text-center { text-align: center; }
                h1, h2, h3, h4 { page-break-after: avoid; color: #285d70; }
                h1 { margin: 2mm 0; font-size: 16pt; }
                h2 { margin: 0 0 3mm; font-size: 11pt; text-align: center; text-transform: uppercase; }
                h3 { margin: 0 0 2mm; font-size: 10pt; }
                h4 { margin: 0 0 2mm; font-size: 9pt; }
                p { margin: 0 0 2mm; }
                ul, ol { margin: 1.5mm 0 1.5mm 5mm; padding-left: 3mm; }
                li { margin-bottom: 0.8mm; }
                a { color: inherit; text-decoration: none; }
                .ribbon { margin: 3mm 0 0; text-align: center; }
                .app-badge { display: inline-block; margin: 0 1mm; padding: 1mm 2mm; color: #285d70; background: #e5eef1; border-radius: 1mm; font-weight: bold; }
                .pdf-metrics { width: 100%; border-collapse: separate; border-spacing: 2mm 0; text-align: center; }
                .pdf-metrics td { width: 33.33%; padding: 2.5mm; background: #eef3f5; border-bottom: 1mm solid #285d70; }
                .pdf-metrics strong { display: block; font-size: 15pt; color: #285d70; }
                .pdf-metrics span { font-size: 8pt; text-transform: uppercase; }
                .info { margin-top: 2mm; }
                .subtitle { color: #555; font-style: italic; }
                .mt-2 { margin-top: 4mm !important; }
                .mb-0, .my-0 { margin-bottom: 0 !important; }
                .mx-0 { margin-right: 0 !important; margin-left: 0 !important; }
                canvas, .print-button { display: none !important; }
            </style>
        {% endif %}

        {% if not pdfMode|default(false) %}
            {% block javascripts %}
                {% block importmap %}{{ importmap('app') }}{% endblock %}
            {% endblock %}
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>

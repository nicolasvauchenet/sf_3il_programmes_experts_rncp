{% extends 'base.html.twig' %}

{% block title %}{{ structure.meta.programTitle ?? 'Résumé du Référentiel' }}{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid third">
            <section class="app-section">
                <h1>{{ structure.meta.programTitle ?? 'Résumé du Référentiel' }}</h1>

                <div class="ribbon">
                    <span class="app-badge">RNCP{{ structure.meta.rncpCode }}</span>
                    <span class="app-badge">{{ promotion | upper }}</span>
                    <span class="app-badge">{{ structure.meta.academicYear ?? year }}</span>
                </div>

                <p class="subtitle">
                    Vue d’ensemble du référentiel : volumes globaux et emplacements réservés aux futurs
                    graphiques de densité.
                </p>
            </section>

            <section class="app-section">
                <h2>Métriques</h2>

                <div class="app-grid four">
                    <span>{{ structure.blocks | length }} Blocs</span>
                    <span>{{ structure.modules | length }} Modules</span>
                    <span>{{ structure.skills | length }} Compétences</span>
                    <span>{{ structure.evaluations | length }} Evaluations</span>
                </div>
            </section>
        </div>

        <section class="app-section">
            <div class="app-grid two">
                <div class="app-stats">
                    <h2>Densité des Blocs</h2>
                    <p>(modules par bloc)</p>
                </div>

                <div class="app-stats">
                    <h2>Densité des Modules</h2>
                    <p>(compétences par module)</p>
                </div>

                <div class="app-stats">
                    <h2>Densité des Evaluations</h2>
                    <p>(modules par évaluation)</p>
                </div>

                <div class="app-stats">
                    <h2>Densité des Evaluations</h2>
                    <p>(compétences par évaluation)</p>
                </div>
            </div>
        </section>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

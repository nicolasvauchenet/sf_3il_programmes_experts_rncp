{% extends 'base.html.twig' %}

{% block title %}{{ framework.parcours.intitule }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
        {% include '_layout/default/_header_promotion.html.twig' %}
        {% include '_layout/default/_flash_messages.html.twig' %}

        <main class="flex-1">
            <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
                <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10 space-y-8">
                    <header class="space-y-3">
                        <div class="flex items-center justify-between rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 mb-3">
                            <span>Année académique {{ year }}</span>
                            <span>{{ framework.parcours.code | upper }}</span>
                        </div>

                        <h2 class="text-2xl font-semibold tracking-tight text-center">
                            {{ framework.parcours.intitule }}
                        </h2>
                        <h3 class="text-xl font-semibold tracking-tight text-center">
                            {{ framework.annees | length }}
                            année{{ framework.annees | length > 1 ? 's' : '' }} d'études
                        </h3>
                    </header>

                    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                        {% include '_charts/_avaluations_vs_skills.html.twig' with { chart: evaluationsVsSkillsChart } %}
                        {% include '_charts/_modules_by_semester.html.twig' with { modulesBySemesterChart: modulesBySemesterChart } %}
                    </section>

                    <section class="space-y-3">
                        <h3 class="text-lg font-semibold">Dump des données</h3>
                        <p class="text-sm text-slate-700 leading-relaxed">
                            {{ dump(framework) }}
                        </p>
                    </section>
                </article>
            </div>
        </main>

        {% include '_layout/default/_footer.html.twig' %}
    </div>
{% endblock %}

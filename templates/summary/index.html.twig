{% extends 'base.html.twig' %}

{% block title %}{{ promotionContext.promotionLabel ?? 'Résumé du Référentiel' }}{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid two">
            <section class="app-section centered">
                <h1>{{ structure.meta.programTitle ?? 'Résumé du Référentiel' }}</h1>

                <p class="subtitle">
                    Tableau de bord du référentiel : visualisation de la répartition des blocs de compétences, des
                    matières enseignées, des compétences et des évaluations du programme.
                </p>

                <div class="ribbon">
                    <span class="app-badge">RNCP{{ structure.meta.rncpCode }}</span>
                    <span class="app-badge">{{ promotion | upper }}</span>
                    <span class="app-badge">{{ structure.meta.academicYear ?? year }}</span>
                </div>
            </section>

            <div class="app-grid third my-0 mx-0">
                <section class="app-section centered">
                    <h2>Structure du référentiel</h2>

                    <div class="summary-card" style="height: 200px;">
                        {{ render_chart(referentialVolumeChart) }}
                    </div>
                </section>

                <section class="app-section bg-alt centered">
                    <h2>Téléchargements</h2>
                    <div class="app-grid mt-2">
                        <a href="{{ asset('source/' ~ promotion ~ '_' ~ year ~ '/referentiel-rncp.pdf') }}"
                           class="app-button download"
                           target="_blank">
                            Référentiel RNCP
                        </a>
                        <a href="{{ asset('source/' ~ promotion ~ '_' ~ year ~ '/matrice-de-couverture.xlsx') }}"
                           class="app-button download"
                           target="_blank">
                            Matrice de couverture
                        </a>
                        <a href="{{ asset('source/' ~ promotion ~ '_' ~ year ~ '/reglement-des-examens.pdf') }}"
                           class="app-button download"
                           target="_blank">
                            Règlement des examens
                        </a>
                    </div>
                </section>
            </div>
        </div>

        <div class="app-grid two">
            <section class="app-section">
                <h2>Répartition des matières par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(modulesPerBlockChart, {
                        'data-controller': 'chart-modules-by-block-link',
                        'data-chart-modules-by-block-link-promotion-value': promotion,
                        'data-chart-modules-by-block-link-year-value': year
                    }) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des projets par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(projectsPerBlockChart, {
                        'data-controller': 'chart-projects-by-block-link',
                        'data-chart-projects-by-block-link-promotion-value': promotion,
                        'data-chart-projects-by-block-link-year-value': year
                    }) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des compétences par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(skillsPerBlockChart, {
                        'data-controller': 'chart-skills-by-block-link',
                        'data-chart-skills-by-block-link-promotion-value': promotion,
                        'data-chart-skills-by-block-link-year-value': year
                    }) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des évaluations par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(evaluationsPerBlockChart, {
                        'data-controller': 'chart-evaluations-by-block-link',
                        'data-chart-evaluations-by-block-link-promotion-value': promotion,
                        'data-chart-evaluations-by-block-link-year-value': year
                    }) }}
                </div>
            </section>
        </div>

        <div class="app-grid two">
            <section class="app-section">
                <h2>Répartition des matières par Évaluation (EC)</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(modulesPerEvaluationChart, {
                        'data-controller': 'chart-evaluations-link',
                        'data-chart-evaluations-link-promotion-value': promotion,
                        'data-chart-evaluations-link-year-value': year
                    }) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des compétences par Évaluation (EC)</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(skillsPerEvaluationChart, {
                        'data-controller': 'chart-evaluations-link',
                        'data-chart-evaluations-link-promotion-value': promotion,
                        'data-chart-evaluations-link-year-value': year
                    }) }}
                </div>
            </section>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

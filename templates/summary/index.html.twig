{% extends 'base.html.twig' %}

{% block title %}{{ promotionContext.promotionLabel ?? 'Résumé du Référentiel' }}{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid two">
            <section class="app-section centered">
                <h1>{{ structure.meta.programTitle ?? 'Résumé du Référentiel' }}</h1>

                <p class="subtitle">
                    Tableau de bord du référentiel : visualisation de la répartition des blocs de compétences, des matières enseignées, des compétences et des évaluations du programme.
                </p>

                <div class="ribbon">
                    <span class="app-badge">RNCP{{ structure.meta.rncpCode }}</span>
                    <span class="app-badge">{{ promotion | upper }}</span>
                    <span class="app-badge">{{ structure.meta.academicYear ?? year }}</span>
                </div>
            </section>

            <section class="app-section">
                <h2>Structure du référentiel</h2>

                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(referentialVolumeChart) }}
                </div>
            </section>
        </div>

        <div class="app-grid three">
            <section class="app-section">
                <h2>Répartition des matières par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(modulesPerBlockChart) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des compétences par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(skillsPerBlockChart) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des évaluations par bloc</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(evaluationsPerBlockChart) }}
                </div>
            </section>
        </div>

        <div class="app-grid two">
            <section class="app-section">
                <h2>Répartition des matières par Évaluation (EC)</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(modulesPerEvaluationChart) }}
                </div>
            </section>

            <section class="app-section">
                <h2>Répartition des compétences par Évaluation (EC)</h2>
                <div class="summary-card" style="height: 200px;">
                    {{ render_chart(skillsPerEvaluationChart) }}
                </div>
            </section>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

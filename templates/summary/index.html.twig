{% extends 'base.html.twig' %}

{% block title %}{{ structure.meta.certificationName }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
        {% include '_layout/default/_header_promotion.html.twig' %}
        {% include '_layout/default/_flash_messages.html.twig' %}

        <main class="flex-1">
            <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
                <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10 space-y-8">
                    <header class="space-y-3">
                        <div class="flex items-center justify-between rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 mb-3">
                            <span>Année académique {{ year }}</span>
                            <span>{{ (structure.parcours.code ?? promotion) | upper }}</span>
                        </div>

                        <h2 class="text-2xl font-semibold tracking-tight text-center">
                            {{ structure.meta.certificationName }}
                        </h2>

                        <h3 class="text-xl font-semibold tracking-tight text-center">
                            {{ summary.modulesTotal }} module{{ summary.modulesTotal > 1 ? 's' : '' }}
                            •
                            {{ summary.skillsTotal }} compétence{{ summary.skillsTotal > 1 ? 's' : '' }}
                        </h3>
                    </header>

                    <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                        <div class="rounded-xl bg-slate-50 p-6 ring-1 ring-slate-200">
                            <h3 class="text-sm font-semibold text-slate-900">Couverture des relations</h3>
                            <dl class="mt-4 space-y-2 text-sm text-slate-700">
                                <div class="flex justify-between">
                                    <dt>Modules avec compétences</dt>
                                    <dd class="font-medium text-slate-900">{{ summary.modulesWithSkills }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Modules sans compétences</dt>
                                    <dd class="font-medium text-slate-900">{{ summary.modulesWithoutSkills }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Compétences reliées (uniques)</dt>
                                    <dd class="font-medium text-slate-900">{{ summary.linkedSkillsUnique }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt>Compétences non reliées</dt>
                                    <dd class="font-medium text-slate-900">{{ summary.unlinkedSkills }}</dd>
                                </div>
                            </dl>
                        </div>

                        <div class="rounded-xl bg-slate-50 p-6 ring-1 ring-slate-200">
                            <h3 class="text-sm font-semibold text-slate-900">À venir</h3>
                            <p class="mt-3 text-sm text-slate-700">
                                Charts basés sur
                                <code class="rounded bg-white px-1 py-0.5 ring-1 ring-slate-200">skillsPerModule</code>
                                et
                                <code class="rounded bg-white px-1 py-0.5 ring-1 ring-slate-200">unlinkedSkills</code>
                                .
                            </p>
                        </div>
                    </section>

                    {% if warnings is not empty %}
                        <section class="space-y-3">
                            <h3 class="text-lg font-semibold">Warnings</h3>
                            <div class="rounded-xl bg-amber-50 p-4 ring-1 ring-amber-200">
                                <ul class="space-y-1 text-sm text-amber-900">
                                    {% for w in warnings %}
                                        <li>
                                            <span class="font-medium">{{ w.code.value }}</span>
                                            —
                                            {{ w.message }}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </section>
                    {% endif %}

                    <section class="space-y-3">
                        <h3 class="text-lg font-semibold">Dump des données</h3>

                        <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200 overflow-auto">
                            <pre class="text-xs leading-relaxed text-slate-800">{{ dump({
                                    structure: structure,
                                    modulesCount: modules|length,
                                    skillsCount: skills|length,
                                    summary: summary,
                                    skillsPerModule: skillsPerModule,
                                    unlinkedSkills: unlinkedSkills
                                }) }}</pre>
                        </div>
                    </section>
                </article>
            </div>
        </main>

        {% include '_layout/default/_footer.html.twig' %}
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    {{ promotionContext.promotionLabel ?? 'Résumé du Référentiel' }}
    - Compétence -
    {{ skill.title() ?: '' }}
{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid third layout">
            {% include '_layout/default/_toc.html.twig' with {
                'title': 'Compétence',
                'path': 'app_promotion_skills',
                'promotion': promotion,
                'year': year,
                'content': skills,
                'selectedCode': selectedCode
            } %}

            <article>
                <div class="app-grid third">
                    <section class="app-section centered">
                        <h1>{{ skill.title() ?: 'Compétence' }}</h1>

                        <h3 class="text-center">{{ promotionContext.promotionTitle }}</h3>

                        <div class="info">
                            <h4 class="text-center mb-0">Fiche Compétence - Bloc {{ skill.blocCode }}</h4>
                            <p class="subtitle">
                                {{ skill.blocName }}
                            </p>
                        </div>

                        <div class="ribbon">
                            <span class="app-badge">{{ promotion | upper }}</span>
                            <span class="app-badge">{{ skill.fullSkillCode() }}</span>
                            {% if skill.academicYear() %}
                                <span class="app-badge">{{ skill.academicYear() }}</span>
                            {% endif %}
                        </div>
                    </section>

                    <section class="app-section centered">
                        <h2>Métriques</h2>

                        <div style="height: 200px">
                            {{ render_chart(skillMetricsChart) }}
                        </div>
                    </section>
                </div>

                {% if skill.description is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Définition</h2>
                        <p>{{ skill.description }}</p>
                    </section>
                {% endif %}

                {% if skill.criteria is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Critères d’évaluation</h2>

                        <div class="skill-criteria-list">
                            <ul>
                                {% for criterion in skill.criteria %}
                                    <li>{{ criterion }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </section>
                {% endif %}

                <div class="app-grid two">
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Matières associées</h2>

                        {% if skill.modules is not empty %}
                            {% for module in skill.modules %}
                                <section class="app-section mb-2">
                                    <p>
                                        <a href="{{ path('app_promotion_modules', {'promotion': promotion, 'year': year, 'code': (skill.blocCode ~ module.code) | lower}) }}" target="_blank">
                                            <strong>Matière {{ module.code }}</strong>
                                        </a>
                                        <br/>
                                        {{ module.title }}
                                    </p>
                                </section>
                            {% endfor %}
                        {% else %}
                            <p class="subtitle">Aucun module associé pour cette compétence.</p>
                        {% endif %}
                    </section>

                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Épreuves certifiantes associées</h2>

                        {% if skill.evaluations is not empty %}
                            {% for evaluation in skill.evaluations %}
                                <section class="app-section mb-2">
                                    <p>
                                        <a href="{{ path('app_promotion_evaluations', {'promotion': promotion, 'year': year, 'code': (skill.blocCode ~ evaluation.code) | lower}) }}" target="_blank">
                                            <strong>Évaluation {{ evaluation.code }}</strong>
                                        </a>
                                        <br/>
                                        Bloc évalué : {{ evaluation.blockCode }}
                                    </p>
                                </section>
                            {% endfor %}
                        {% else %}
                            <p class="subtitle">Aucune épreuve certifiante associée pour cette compétence.</p>
                        {% endif %}
                    </section>
                </div>
            </article>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}
    {{ promotionContext.promotionLabel ? promotionContext.promotionLabel | upper : 'Résumé du Référentiel' }}
    - Compétence {{ skill.fullSkillCode }} -
    {{ skill.title ?: '' }}
{% endblock %}

{% block body %}
    {% if not pdfMode|default(false) %}
        {% include '_layout/default/_header.html.twig' %}
        {% include '_layout/default/_alert.html.twig' %}
    {% endif %}

    <main class="app-main">
        <div class="{{ pdfMode|default(false) ? '' : 'app-grid third layout' }}">
            {% if not pdfMode|default(false) %}{% include '_layout/default/_toc.html.twig' with {
                'title': 'Compétence',
                'path': 'app_promotion_skills',
                'promotion': promotion,
                'year': year,
                'content': skills,
                'selectedCode': selectedCode
            } %}{% endif %}

            <article class="printable-content">
                {% if pdfMode|default(false) %}
                    <section class="pdf-cover">
                        <div class="pdf-cover-kicker">Fiche compétence</div>
                        <div class="pdf-cover-program">{{ promotionContext.promotionTitle }}</div>
                        <div class="pdf-cover-code">{{ skill.fullSkillCode }}</div>
                        <h1>{{ skill.title ?: 'Compétence' }}</h1>
                        <div class="pdf-cover-rule"></div>
                        <table class="pdf-cover-details"><tr>
                            <td><span>Bloc de compétences</span><strong>{{ skill.blocCode }}</strong><small>{{ skill.blocName }}</small></td>
                            <td><span>Promotion</span><strong>{{ promotion|upper }}</strong><small>{{ skill.academicYear ?: year }}</small></td>
                            <td><span>Référence RNCP</span><strong>{{ skill.rncpCode ?: '—' }}</strong><small>{{ skill.skillCode }}</small></td>
                        </tr></table>
                        <table class="pdf-cover-stats"><tr>
                            <td><strong>{{ skill.modules|length }}</strong><span>Matières</span></td>
                            <td><strong>{{ skill.projects|length }}</strong><span>Projets</span></td>
                            <td><strong>{{ skill.evaluations|length }}</strong><span>Évaluations</span></td>
                        </tr></table>
                        <div class="pdf-cover-footer">Référentiels RNCP · 3iL Ingénieurs</div>
                    </section>
                {% endif %}
                <div class="app-grid third">
                    {% if not pdfMode|default(false) %}<section class="app-section centered">
                        <h3 class="text-center alt">{{ promotionContext.promotionTitle }}</h3>

                        <div class="info">
                            <h4 class="text-center">Fiche Compétence {{ skill.fullSkillCode }}</h4>
                            <h1>{{ skill.title ?: 'Compétence' }}</h1>
                        </div>

                        <div class="ribbon">
                            <span class="app-badge">{{ promotion | upper }}</span>
                            <span class="app-badge">{{ skill.fullSkillCode }}</span>
                            {% if skill.academicYear %}
                                <span class="app-badge">{{ skill.academicYear }}</span>
                            {% endif %}

                            {% if not pdfMode|default(false) %}
                                {% include '_layout/default/_print_button.html.twig' %}
                            {% endif %}
                        </div>
                    </section>{% endif %}

                    {% if not pdfMode|default(false) %}<section class="app-section centered">
                        <h2>Métriques</h2>

                        <div style="height: 200px">
                            {{ render_chart(skillMetricsChart) }}
                        </div>
                    </section>
                    {% endif %}
                </div>

                {% if skill.description is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>{{ skill.blocCode }} : {{ skill.blocName }}</h2>

                        <p>{{ skill.description }}</p>
                    </section>
                {% endif %}

                {% if skill.criteria is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Critères d’évaluation</h2>

                        <div class="skill-criteria-list">
                            {% for criterion in skill.criteria %}
                                {% set rawCriterion = criterion|trim %}
                                {% set parts = rawCriterion|split(':', 2) %}
                                {% set label = (parts[0] ?? '')|trim %}
                                {% set details = (parts[1] ?? '')|trim %}

                                <section class="app-section pdf-skill mb-2">
                                    <p>
                                        {% if details %}
                                            <strong>{{ label }}</strong>
                                            <br/>
                                            {{ details }}
                                        {% else %}
                                            {{ rawCriterion }}
                                        {% endif %}
                                    </p>
                                </section>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                <div class="app-grid two pdf-associations">
                    {% if skill.modules is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Matières associées</h2>

                            <div class="app-grid">
                                {% for module in skill.modules %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_modules', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': module.fullCode
                                            }) }}">
                                                <strong>{{ module.fullCode | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ module.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if skill.projects is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Projets associés</h2>

                            <div class="app-grid">
                                {% for project in skill.projects %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_projects', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': project.code
                                            }) }}">
                                                <strong>{{ project.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ project.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if skill.evaluations is not empty %}
                        <section class="app-section mx-0  mb-0">
                            <h2>Évaluations associées</h2>

                            <div class="app-grid">
                                {% for evaluation in skill.evaluations %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_evaluations', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': evaluation.code
                                            }) }}">
                                                <strong>{{ evaluation.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ evaluation.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}
                </div>
            </article>
        </div>
    </main>

    {% if not pdfMode|default(false) %}{% include '_layout/default/_footer.html.twig' %}{% endif %}
{% endblock %}

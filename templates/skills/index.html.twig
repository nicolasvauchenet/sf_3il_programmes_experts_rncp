{% extends 'base.html.twig' %}

{% block title %}Fiche Compétence{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid third reverse">
            {% include '_layout/default/_toc.html.twig' with {'title': 'Compétences', 'path': 'app_promotion_skills', 'code': code} %}

            <article>
                <div class="app-grid third">
                    <section class="app-section">
                        <h1>Fiche compétence {{ code }}</h1>

                        <div class="ribbon">
                            <span class="app-badge">{{ promotion | upper }}</span>
                        </div>

                        <p class="subtitle">
                            ...
                        </p>
                    </section>

                    <section class="app-section">
                        <h2>Métriques</h2>

                        <div class="app-grid four">
                            <span>...</span>
                        </div>
                    </section>
                </div>

                <section class="app-section mx-0 mt-2 mb-0">
                    <h2>Contenu</h2>
                    <p>...</p>
                </section>
            </article>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

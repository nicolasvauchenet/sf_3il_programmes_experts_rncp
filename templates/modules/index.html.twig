{% extends 'base.html.twig' %}

{% block title %}
    {{ promotionContext.promotionLabel ?? 'Résumé du Référentiel' }}
    - Matière {{ module.moduleCode }} -
    {{ module.title ?: '' }}
{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid third layout">
            {% include '_layout/default/_toc.html.twig' with {
                'title': 'Matière',
                'path': 'app_promotion_modules',
                'promotion': promotion,
                'year': year,
                'content': modules,
                'selectedCode': selectedCode
            } %}

            <article>
                <div class="app-grid third">
                    <section class="app-section centered">
                        <h3 class="text-center alt">{{ promotionContext.promotionTitle }}</h3>

                        <div class="info">
                            <h4 class="text-center">Fiche Matière {{ module.moduleCode }}</h4>
                            <h1>{{ module.title ?: 'Matière' }}</h1>
                        </div>

                        <div class="ribbon mt-2">
                            <span class="app-badge">{{ promotion | upper }}</span>

                            {% if module.blocCode and module.moduleCode %}
                                <span class="app-badge">{{ module.moduleCode }}</span>
                            {% elseif module.moduleCode %}
                                <span class="app-badge">{{ module.moduleCode }}</span>
                            {% endif %}

                            <span class="app-badge">{{ year }}</span>
                        </div>
                    </section>

                    <section class="app-section centered">
                        <h2>Métriques</h2>

                        <div style="height: 200px">
                            {{ render_chart(moduleVolumeChart) }}
                        </div>
                    </section>
                </div>

                {% if module.objectives.description is defined and module.objectives.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>{{ module.blocCode }} : {{ module.blocName }}</h2>
                        <p>{{ module.objectives.description }}</p>
                    </section>
                {% endif %}

                {% if module.prerequisites.description is defined and module.prerequisites.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Prérequis</h2>
                        <p>{{ module.prerequisites.description }}</p>
                    </section>
                {% endif %}

                {% set chapters = module.outline.chapters ?? [] %}
                {% if chapters is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Plan des cours</h2>
                        {% for ch in chapters %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <h3>{{ ch.title ?? 'Chapitre' }}</h3>
                                {% set items = ch.items ?? [] %}
                                {% if items is not empty %}
                                    <ul>
                                        {% for it in items %}
                                            <li>{{ it }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if module.exercises is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Exemples d'Exercices</h2>

                        {% for ex in module.exercises %}
                            {% set title = ex.title ?? 'Exercice' %}
                            {% set context = (ex.context ?? '')|trim %}
                            {% set objective = (ex.objective ?? '')|trim %}
                            {% set objectiveText = objective ?: context %}
                            {% set hasObjective = objectiveText|length > 0 %}
                            {% set hasContext = context|length > 0 and objective|length > 0 %}
                            {% set normContext = context|lower|replace({"\n":" ", "\r":" ", "\t":" "}) %}
                            {% set normObjective = objective|lower|replace({"\n":" ", "\r":" ", "\t":" "}) %}
                            {% set normContext = normContext|split(' ')|filter(v => v != '')|join(' ') %}
                            {% set normObjective = normObjective|split(' ')|filter(v => v != '')|join(' ') %}
                            {% set showContextAndObjective = hasContext and (normContext != normObjective) %}

                            <section class="app-section mx-0 mt-2 mb-0">
                                <h3>Exercice {{ loop.index }} : {{ title }}</h3>

                                {% if showContextAndObjective %}
                                    <p><strong>Contexte :</strong> {{ context }}</p>
                                    <p><strong>Objectif :</strong> {{ objective }}</p>
                                {% else %}
                                    {% if hasObjective %}
                                        <p><strong>Objectif :</strong> {{ objectiveText }}</p>
                                    {% endif %}
                                {% endif %}
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if module.skillsWithCriteria is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in module.skillsWithCriteria %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {
                                        'promotion': promotion,
                                        'year': year,
                                        'code': s.fileCode
                                    }) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>

                            {% if s.criteria is not empty %}
                                <section class="app-section sub">
                                    <p class="mb-1"><strong>Critères d’évaluation</strong></p>
                                    <ul>
                                        {% for criterion in s.criteria %}
                                            <li>{{ criterion }}</li>
                                        {% endfor %}
                                    </ul>
                                </section>
                            {% endif %}
                        {% endfor %}
                    </section>
                {% endif %}

                {% if module.bibliography is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Bibliographie</h2>

                        <ul>
                            {% for book in module.bibliography %}
                                <li class="text-left">
                                    {{ book.title ?? '—' }}
                                    {% if book.author is defined %}
                                        - {{ book.author }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                {% if module.onlineResources is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Ressources en ligne</h2>

                        <ul>
                            {% for resource in module.onlineResources %}
                                {% set parts = resource|split('(') %}
                                {% set label = parts[0]|trim|replace({'—': '-'}) %}
                                {% set url = parts|length > 1 ? parts[1]|split(')')[0] : null %}

                                <li class="text-left">
                                    {% if url %}
                                        <a href="{{ url }}" target="_blank" rel="noopener noreferrer">
                                            {{ label }}
                                        </a>
                                    {% else %}
                                        {{ resource }}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                {% if module.teachingMethods is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Méthodes pédagogiques</h2>

                        <ul>
                            {% for method in module.teachingMethods %}
                                <li class="text-left">{{ method }}</li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                <div class="app-grid two">
                    {% if module.projects is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Projets associés</h2>

                            <div class="app-grid">
                                {% for project in module.projects %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_projects', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': project.code
                                            }) }}">
                                                <strong>{{ project.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ project.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if module.evaluations is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Évaluations associées</h2>

                            <div class="app-grid">
                                {% for evaluation in module.evaluations %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_evaluations', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': evaluation.code
                                            }) }}">
                                                <strong>{{ evaluation.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ evaluation.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}
                </div>
            </article>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

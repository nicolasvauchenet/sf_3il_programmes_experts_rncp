{% extends 'base.html.twig' %}

{% block title %}
    {{ promotionContext.promotionLabel ? promotionContext.promotionLabel | upper : 'Résumé du Référentiel' }}
    - Projet {{ project.projectCode }} -
    {{ project.title ?: '' }}
{% endblock %}

{% block body %}
    {% if not pdfMode|default(false) %}
        {% include '_layout/default/_header.html.twig' %}
        {% include '_layout/default/_alert.html.twig' %}
    {% endif %}

    <main class="app-main">
        <div class="{{ pdfMode|default(false) ? '' : 'app-grid third layout' }}">
            {% if not pdfMode|default(false) %}{% include '_layout/default/_toc.html.twig' with {
                'title': 'Projet',
                'path': 'app_promotion_projects',
                'promotion': promotion,
                'year': year,
                'content': projects,
                'selectedCode': selectedCode
            } %}{% endif %}

            <article class="printable-content">
                {% if pdfMode|default(false) %}
                    {% set chapters = project.outline.chapters ?? [] %}
                    <section class="pdf-cover">
                        <div class="pdf-cover-kicker">Fiche projet</div>
                        <div class="pdf-cover-program">{{ promotionContext.promotionTitle }}</div>
                        <div class="pdf-cover-code">{{ project.projectCode }}</div>
                        <h1>{{ project.title ?: 'Projet' }}</h1>
                        <div class="pdf-cover-rule"></div>
                        <table class="pdf-cover-details"><tr>
                            <td><span>Bloc de compétences</span><strong>{{ project.blocCode }}</strong><small>{{ project.blocName }}</small></td>
                            <td><span>Promotion</span><strong>{{ promotion|upper }}</strong><small>{{ project.academicYear ?: year }}</small></td>
                            <td><span>Volume pédagogique</span><strong>{{ project.durationHours }} h</strong><small>{{ project.durationDays }} jour{{ project.durationDays > 1 ? 's' : '' }}</small></td>
                        </tr></table>
                        <table class="pdf-cover-stats"><tr>
                            <td><strong>{{ project.skills|length }}</strong><span>Compétences</span></td>
                            <td><strong>{{ chapters|length }}</strong><span>Chapitres</span></td>
                            <td><strong>{{ project.exercises|length }}</strong><span>Exercices</span></td>
                            <td><strong>{{ project.modules|length }}</strong><span>Matières</span></td>
                            <td><strong>{{ project.evaluations|length }}</strong><span>Évaluations</span></td>
                        </tr></table>
                        <div class="pdf-cover-footer">Référentiels RNCP · 3iL Ingénieurs</div>
                    </section>
                {% endif %}
                <div class="app-grid third">
                    {% if not pdfMode|default(false) %}
                        <section class="app-section centered">
                        <h3 class="text-center alt">{{ promotionContext.promotionTitle }}</h3>

                        <div class="info">
                            <h4 class="text-center">Fiche Projet {{ project.projectCode }}</h4>
                            <h1>{{ project.title ?: 'Projet' }}</h1>
                        </div>

                        <div class="ribbon mt-2">
                            <span class="app-badge">{{ promotion | upper }}</span>

                            {% if project.blocCode and project.projectCode %}
                                <span class="app-badge">{{ project.projectCode }}</span>
                            {% elseif project.projectCode %}
                                <span class="app-badge">{{ project.projectCode }}</span>
                            {% endif %}

                            <span class="app-badge">{{ year }}</span>

                            {% if not pdfMode|default(false) %}
                                {% include '_layout/default/_print_button.html.twig' %}
                            {% endif %}
                        </div>
                        </section>{% endif %}

                    {% if not pdfMode|default(false) %}
                        <section class="app-section centered">
                        <h2>Métriques</h2>

                        <div style="height: 200px">
                            {{ render_chart(projectVolumeChart) }}
                        </div>
                        </section>
                    {% endif %}
                </div>

                {% if project.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Description</h2>

                        <p>{{ project.description }}</p>
                    </section>
                {% endif %}

                {% if project.objectives.description is defined and project.objectives.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>{{ project.blocCode }} : {{ project.blocName }}</h2>

                        <p>{{ project.objectives.description }}</p>
                    </section>
                {% endif %}

                {% if project.prerequisites.description is defined and project.prerequisites.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Prérequis</h2>
                        <p>{{ project.prerequisites.description }}</p>
                    </section>
                {% endif %}

                {% set chapters = project.outline.chapters ?? [] %}
                {% if chapters is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Plan des cours</h2>
                        {% for ch in chapters %}
                            <section class="app-section pdf-chapter mx-0 mt-2 mb-0">
                                <h3>{{ ch.title ?? 'Chapitre' }}</h3>
                                {% set items = ch.items ?? [] %}
                                {% if items is not empty %}
                                    <ul>
                                        {% for it in items %}
                                            <li>{{ it }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if project.exercises is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Exemples d'Exercices</h2>

                        {% for ex in project.exercises %}
                            {% set title = ex.title ?? 'Exercice' %}
                            {% set context = (ex.context ?? '')|trim %}
                            {% set objective = (ex.objective ?? '')|trim %}
                            {% set objectiveText = objective ?: context %}
                            {% set hasObjective = objectiveText|length > 0 %}
                            {% set hasContext = context|length > 0 and objective|length > 0 %}
                            {% set normContext = context|lower|replace({"\n":" ", "\r":" ", "\t":" "}) %}
                            {% set normObjective = objective|lower|replace({"\n":" ", "\r":" ", "\t":" "}) %}
                            {% set normContext = normContext|split(' ')|filter(v => v != '')|join(' ') %}
                            {% set normObjective = normObjective|split(' ')|filter(v => v != '')|join(' ') %}
                            {% set showContextAndObjective = hasContext and (normContext != normObjective) %}

                            <section class="app-section pdf-exercise mx-0 mt-2 mb-0">
                                <h3>Exercice {{ loop.index }} : {{ title }}</h3>

                                {% if showContextAndObjective %}
                                    <p><strong>Contexte :</strong> {{ context }}</p>
                                    <p><strong>Objectif :</strong> {{ objective }}</p>
                                {% else %}
                                    {% if hasObjective %}
                                        <p><strong>Objectif :</strong> {{ objectiveText }}</p>
                                    {% endif %}
                                {% endif %}
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if project.skillsWithCriteria is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in project.skillsWithCriteria %}
                            <section class="app-section pdf-skill mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {
                                        'promotion': promotion,
                                        'year': year,
                                        'code': s.fileCode
                                    }) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>

                            {% if s.criteria is not empty %}
                                <section class="app-section sub">
                                    <p class="mb-1">
                                        <strong>Critères d’évaluation</strong>
                                    </p>

                                    <ul>
                                        {% for criterion in s.criteria %}
                                            <li>{{ criterion }}</li>
                                        {% endfor %}
                                    </ul>
                                </section>
                            {% endif %}
                        {% endfor %}
                    </section>
                {% elseif project.skills is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in project.skills %}
                            <section class="app-section pdf-skill mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {
                                        'promotion': promotion,
                                        'year': year,
                                        'code': s.fileCode
                                    }) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                <div class="app-grid two pdf-associations">
                    {% if project.modules is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Matières associées</h2>

                            <div class="app-grid">
                                {% for module in project.modules %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_modules', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': module.code
                                            }) }}">
                                                <strong>{{ module.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ module.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {% if project.evaluations is not empty %}
                        <section class="app-section mx-0 mt-2 mb-0">
                            <h2>Évaluations associées</h2>

                            <div class="app-grid">
                                {% for evaluation in project.evaluations %}
                                    <section class="app-section mx-0 my-0">
                                        <p class="mb-0">
                                            <a href="{{ path('app_promotion_evaluations', {
                                                'promotion': promotion,
                                                'year': year,
                                                'code': evaluation.code
                                            }) }}">
                                                <strong>{{ evaluation.code | upper }}</strong>
                                            </a>
                                        </p>

                                        <p class="subtitle text-left mb-0">{{ evaluation.title ?: '-' }}</p>
                                    </section>
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}
                </div>
            </article>
        </div>
    </main>

    {% if not pdfMode|default(false) %}{% include '_layout/default/_footer.html.twig' %}{% endif %}
{% endblock %}

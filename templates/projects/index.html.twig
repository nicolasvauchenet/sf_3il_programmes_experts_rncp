{% extends 'base.html.twig' %}

{% block title %}
    {{ promotionContext.promotionLabel ?? 'Résumé du Référentiel' }}
    - Projet {{ project.projectCode }} -
    {{ project.title ?: '' }}
{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main">
        <div class="app-grid third layout">
            {% include '_layout/default/_toc.html.twig' with {
                'title': 'Projet',
                'path': 'app_promotion_projects',
                'promotion': promotion,
                'year': year,
                'content': projects,
                'selectedCode': selectedCode
            } %}

            <article>
                <div class="app-grid third">
                    <section class="app-section centered">
                        <h3 class="text-center alt">{{ promotionContext.promotionTitle }}</h3>

                        <div class="info">
                            <h4 class="text-center">Fiche Projet {{ project.projectCode }}</h4>
                            <h1>{{ project.title ?: 'Projet' }}</h1>
                        </div>

                        <div class="ribbon mt-2">
                            <span class="app-badge">{{ promotion | upper }}</span>

                            {% if project.blocCode and project.projectCode %}
                                <span class="app-badge">{{ project.projectCode }}</span>
                            {% elseif project.projectCode %}
                                <span class="app-badge">{{ project.projectCode }}</span>
                            {% endif %}

                            <span class="app-badge">{{ year }}</span>
                        </div>
                    </section>

                    <section class="app-section centered">
                        <h2>Métriques</h2>

                        <div style="height: 200px">
                            {{ render_chart(projectVolumeChart) }}
                        </div>
                    </section>
                </div>

                {% if project.objectives.description is defined and project.objectives.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>{{ project.blocCode }} : {{ project.blocName }}</h2>

                        <p>{{ project.objectives.description }}</p>
                    </section>
                {% endif %}

                {% if project.prerequisites.description is defined and project.prerequisites.description %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Prérequis</h2>
                        <p>{{ project.prerequisites.description }}</p>
                    </section>
                {% endif %}

                {% set chapters = project.outline.chapters ?? [] %}
                {% if chapters is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Plan des cours</h2>
                        {% for ch in chapters %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <h3>{{ ch.title ?? 'Chapitre' }}</h3>
                                {% set items = ch.items ?? [] %}
                                {% if items is not empty %}
                                    <ul>
                                        {% for it in items %}
                                            <li>{{ it }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if project.exercises is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Exemples d'Exercices</h2>

                        {% for ex in project.exercises %}
                            {% set title = ex.title ?? 'Exercice' %}
                            {% set context = (ex.context ?? '')|trim %}
                            {% set objective = (ex.objective ?? '')|trim %}
                            {% set objectiveText = objective ?: context %}
                            {% set hasObjective = objectiveText|length > 0 %}
                            {% set hasContext = context|length > 0 and objective|length > 0 %}
                            {% set normContext = context|lower|replace({"\n":" ", "\r":" ", "\t":" "}) %}
                            {% set normObjective = objective|lower|replace({"\n":" ", "\r":" ", "\t":" "}) %}
                            {% set normContext = normContext|split(' ')|filter(v => v != '')|join(' ') %}
                            {% set normObjective = normObjective|split(' ')|filter(v => v != '')|join(' ') %}
                            {% set showContextAndObjective = hasContext and (normContext != normObjective) %}

                            <section class="app-section mx-0 mt-2 mb-0">
                                <h3>Exercice {{ loop.index }} : {{ title }}</h3>

                                {% if showContextAndObjective %}
                                    <p><strong>Contexte :</strong> {{ context }}</p>
                                    <p><strong>Objectif :</strong> {{ objective }}</p>
                                {% else %}
                                    {% if hasObjective %}
                                        <p><strong>Objectif :</strong> {{ objectiveText }}</p>
                                    {% endif %}
                                {% endif %}
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if project.skillsWithCriteria is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in project.skillsWithCriteria %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {'promotion': promotion, 'year': year, 'code': (project.blocCode ~ s.code) | lower}) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>

                            {% if s.criteria is not empty %}
                                <section class="app-section sub">
                                    <p class="mb-1">
                                        <strong>Critères d’évaluation</strong>
                                    </p>

                                    <ul>
                                        {% for criterion in s.criteria %}
                                            <li>{{ criterion }}</li>
                                        {% endfor %}
                                    </ul>
                                </section>
                            {% endif %}
                        {% endfor %}
                    </section>
                {% elseif project.skills is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Compétences mobilisées</h2>

                        {% for s in project.skills %}
                            <section class="app-section mx-0 mt-2 mb-0">
                                <p>
                                    <a href="{{ path('app_promotion_skills', {'promotion': promotion, 'year': year, 'code': (project.blocCode ~ s.code) | lower}) }}">
                                        <strong>Compétence {{ s.code }}</strong>
                                    </a>
                                    :
                                    {{ s.description }}
                                </p>
                            </section>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if project.evaluations is not empty %}
                    <section class="app-section mx-0 mt-2 mb-0">
                        <h2>Evaluations associées</h2>

                        <div class="app-grid two">
                            {% for evaluation in project.evaluations %}
                                <section class="app-section mx-0 my-0">
                                    <p class="mb-0">
                                        <a href="{{ path('app_promotion_evaluations', {
                                            'promotion': promotion,
                                            'year': year,
                                            'code': (project.blocCode ~ evaluation.code) | lower
                                        }) }}">
                                            <strong>{{ project.blocCode }}{{ evaluation.code | upper }}</strong>
                                        </a>
                                    </p>

                                    <p class="subtitle text-left mb-0">{{ evaluation.title ?: '-' }}</p>
                                </section>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            </article>
        </div>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}

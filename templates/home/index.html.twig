{% extends 'base.html.twig' %}

{% block title %}Choisissez le référentiel{% endblock %}

{% block body %}
    {% include '_layout/default/_header.html.twig' %}
    {% include '_layout/default/_alert.html.twig' %}

    <main class="app-main center">
        <section class="app-section boxed">
            <h1>Choisissez le référentiel</h1>
            <p class="subtitle">Sélectionnez la promotion et le millésime pour continuer.</p>

            <hr/>

            <form data-controller="context"
                  data-context-years-by-promotion-value="{{ yearsByPromotion|json_encode|e('html_attr') }}"
                  data-context-auto-select-latest-year-value="{{ isStudent ? 'true' : 'false' }}"
                  class="app-form"
                  action="{{ path('app_promotion_summary') }}"
            >
                <div class="form-group">
                    <label for="promotion" class="form-label">
                        Promotion
                    </label>
                    <select
                        data-context-target="promotion"
                        data-action="change->context#onPromotionChange"
                        id="promotion"
                        name="promotion"
                        class="form-control"
                        required
                    >
                        <option value="">Choisissez une Promotion</option>
                        {% for promotion in allPromotions %}
                            <option value="{{ promotion }}"
                                    {% if promotion == selectedPromotion %}selected{% endif %}>
                                {{ promotion | upper }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group" {% if isStudent %}hidden{% endif %}>
                    <label for="year" class="form-label">
                        Année académique
                    </label>
                    <select
                        data-context-target="year"
                        data-action="change->context#check"
                        id="year"
                        name="year"
                        class="form-control"
                        required
                        disabled
                    >
                        <option value="">Choisissez un Millésime</option>
                        {% for year in allYears %}
                            <option value="{{ year }}" {% if year == selectedYear %}selected{% endif %}>
                                {{ year | replace({'-':' - '}) }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <div class="hidden-xs">&nbsp;</div>
                    <button type="submit" data-context-target="submit" class="app-button form-submit" disabled>
                        Aller au Référentiel
                    </button>
                </div>
            </form>
        </section>
    </main>

    {% include '_layout/default/_footer.html.twig' %}
{% endblock %}
